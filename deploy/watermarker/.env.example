# Copia in .env (chmod 600 .env) e compila.

# --- Login con Microsoft Entra ID -------------------------------------------
# Dalla registrazione dell'app: "Directory (tenant) ID" e "Application (client) ID"
AZUREAD_TENANT_ID=
AZUREAD_CLIENT_ID=
# Certificates & secrets -> Client secrets -> Value (non l'ID del segreto)
AZUREAD_CLIENT_SECRET=
# Ruolo dell'app richiesto, es. Watermark.User. Vuoto = basta essere assegnati all'app
REQUIRED_ROLE=
SESSION_HOURS=8

# --- API per le altre applicazioni ------------------------------------------
# Ruolo dell'app (Entra ID) che può creare e revocare i token, dalla pagina /admin.html
ADMIN_ROLE=Watermark.Admin
API_ENABLED=true
# Lavori asincroni elaborati insieme (si sommano a MAX_CONCURRENT_JOBS)
API_ASYNC_WORKERS=1
API_MAX_QUEUED_JOBS=50
# Ore per cui un risultato asincrono resta scaricabile
API_RESULT_RETENTION_HOURS=24
# Default per i token che non indicano un proprio limite
API_DEFAULT_REQUESTS_PER_MINUTE=60
API_DEFAULT_MAX_ACTIVE_JOBS=5

# --- Limiti -----------------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_BODY=110MB
MAX_FILES_PER_BATCH=20
MAX_CONCURRENT_JOBS=2
QUEUE_LIMIT=20
CONVERSION_TIMEOUT_SECONDS=120
VIDEO_TIMEOUT_MINUTES=30

# --- Risorse ----------------------------------------------------------------
CPU_LIMIT=2
MEMORY_LIMIT=3g
TMP_SIZE=2g
CONVERTER_CPU_LIMIT=2
CONVERTER_MEMORY_LIMIT=2g

TZ=Europe/Rome
