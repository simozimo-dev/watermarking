# Copia in .env e adatta i valori.

# Nome con cui il portale è raggiungibile (vedi docker/Caddyfile per i certificati)
SITE_ADDRESS=localhost

# Dimensione massima dei file: MAX_BODY deve essere un po' più grande di MAX_UPLOAD_MB
MAX_UPLOAD_MB=100
MAX_BODY=110MB

# Elaborazioni contemporanee e coda
MAX_CONCURRENT_JOBS=2
QUEUE_LIMIT=20

# Timeout
CONVERSION_TIMEOUT_SECONDS=120
VIDEO_TIMEOUT_MINUTES=30

# Risorse del portale (lo spazio temporaneo è in RAM: conta nel limite di memoria)
CPU_LIMIT=2
MEMORY_LIMIT=3g
TMP_SIZE=2g

# Solo per docker-compose.split.yml
CONVERTER_CPU_LIMIT=2
CONVERTER_MEMORY_LIMIT=2g

# Fuso orario per {date} e {time}
TZ=Europe/Rome
