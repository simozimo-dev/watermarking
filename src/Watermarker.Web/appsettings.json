{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Portal": {
    "MaxUploadMb": 100,
    "MaxConcurrentJobs": 2,
    "QueueLimit": 20,
    "MaxTextLength": 200,
    "Fonts": [ "Arial", "Calibri", "Verdana", "Times New Roman", "Courier New" ],
    "LibreOfficePath": null,
    "FfmpegPath": null,
    "ConverterUrl": null,
    "WorkDirectory": null,
    "ConversionTimeoutSeconds": 120,
    "VideoTimeoutMinutes": 30
  }
}
