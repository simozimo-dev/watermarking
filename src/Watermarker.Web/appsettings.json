    "RequiredRole": "",
    "AdminRole": "Watermark.Admin",
    "SessionHours": 8,
    "DataProtectionPath": null,
    "ConversionTimeoutSeconds": 120,
    "VideoTimeoutMinutes": 30
  },
  "Api": {
    "Enabled": true,
    "DataPath": null,
    "JobsPath": null,
    "AsyncWorkers": 1,
    "MaxQueuedJobs": 50,
    "ResultRetentionHours": 24,
    "DefaultRequestsPerMinute": 60,
    "DefaultMaxActiveJobs": 5
