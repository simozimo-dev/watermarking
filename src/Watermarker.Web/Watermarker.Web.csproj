<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Watermarker.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Login con Microsoft Entra ID (OpenID Connect) -->
    <PackageReference Include="Microsoft.Identity.Web" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Descrizione OpenAPI delle API /api/v1, servita da GET /api/v1/openapi.yaml -->
    <EmbeddedResource Include="openapi.yaml" LogicalName="openapi.yaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watermarker.Core\Watermarker.Core.csproj" />
  </ItemGroup>

</Project>
